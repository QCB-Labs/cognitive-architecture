#!/bin/sh
#
# Local pre-commit for cognitive-architecture. Runs after the machine-wide
# guard (core.hooksPath), which already blocks the private name and address.
# This one blocks what that guard doesn't know about: credentials, keys,
# other people's addresses, and files that should never be tracked.
# Holds no private strings itself, so it is safe to keep in the repo.
# Install: see hooks/README.md.

# hooks/ is skipped for content: these files hold the patterns they search for.
ADDED="$(git diff --cached --diff-filter=ACMR -U0 -- . ':(exclude)hooks/' | grep '^+' | grep -v '^+++ ')"
NAMES="$(git diff --cached --diff-filter=ACR --name-only)"

fail() {
    echo "BLOCKED (cognitive-architecture): staged changes contain $1"
    exit 1
}

# --- Credentials ------------------------------------------------------------
# City/Square/Market tokens, Google API keys, GitHub tokens, API secret keys,
# private key blocks, and a Gmail app password written as four groups of four.
printf '%s\n' "$ADDED" | grep -qE '1f3d9_sk_|1f916_sk_|1f3ea_sk_' && fail "a city token"
printf '%s\n' "$ADDED" | grep -qE 'AIza[0-9A-Za-z_-]{20,}' && fail "a Google API key"
printf '%s\n' "$ADDED" | grep -qE 'gh[pousr]_[0-9A-Za-z]{20,}|github_pat_' && fail "a GitHub token"
printf '%s\n' "$ADDED" | grep -qE 'sk-[A-Za-z0-9_-]{20,}' && fail "an API secret key"
printf '%s\n' "$ADDED" | grep -q 'BEGIN [A-Z ]*PRIVATE KEY' && fail "a private key"
printf '%s\n' "$ADDED" | grep -qE '\b[a-z]{4} [a-z]{4} [a-z]{4} [a-z]{4}\b' \
    && fail "what looks like a Gmail app password"

# --- Other people's addresses -----------------------------------------------
# Correspondents' addresses live in the trust anchor, never in a repository.
# Allowed: the public project address, noreply, and documentation domains.
ADDR="$(printf '%s\n' "$ADDED" \
        | grep -oiE '[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}' \
        | grep -viE '@example\.(com|org|net)$' \
        | grep -viE '^qualitycontrolbureau@gmail\.com$' \
        | grep -viE '^noreply@' | head -1)"
[ -n "$ADDR" ] && fail "an email address (use example.com for illustrations)"

# --- Files that must never be tracked ---------------------------------------
BADFILE="$(printf '%s\n' "$NAMES" \
        | grep -iE '(^|/)(secrets[^/]*\.py|\.env[^/]*|[^/]*\.pem|[^/]*\.key|private-patterns\.txt)$' \
        | grep -viE '(secrets\.example\.py|\.env\.example)$' | head -1)"
[ -n "$BADFILE" ] && fail "a credentials or key file"
printf '%s\n' "$NAMES" | grep -qiE '^(ledgers|runs|research/raw|research/private|correspondence|mind/keeper|mind/install)/' \
    && fail "live ledgers, run data, keys or private research material"

# --- Tests ------------------------------------------------------------------
if [ -d mind/tests ]; then
    echo "Running tests..."
    python -m pytest -q mind/tests || fail "failing tests"
fi

exit 0
